isplay_data","data":{"text/plain":["<Figure size 1250x1250 with 30 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["\n","## Correlation Heatmap\n","\n","###Heatmap of Top Correlated Features\n","\n","A correlation heatmap is created using the\n","10 numerical features most strongly correlated\n","with SalePrice.\n","\n","The heatmap displays correlation values\n","using colours and annotations to make\n","relationships easier to understand.\n"],"metadata":{"id":"vxD46leKy7PQ"}},{"cell_type":"code","source":["\n","# CORRELATION HEATMAP\n","\n","# Select top 10 features, excluding SalePrice itself\n","top10_features = (\n","    corr_matrix[\"SalePrice\"]\n","    .drop(\"SalePrice\")\n","    .abs()\n","    .sort_values(ascending=False)\n","    .head(10)\n","    .index.tolist()\n",")\n","\n","# Include SalePrice in the heatmap\n","heatmap_cols = [\"SalePrice\"] + top10_features\n","\n","# Calculate correlation matrix\n","corr_top = df[heatmap_cols].corr()\n","\n","# Create mask to hide upper triangle\n","mask = np.triu(\n","    np.ones_like(corr_top, dtype=bool)\n",")\n","\n","# Plot heatmap\n","plt.figure(figsize=(12, 9))\n","\n","sns.heatmap(\n","    corr_top,\n","    annot=True,\n","    fmt=\".2f\",\n","    cmap=\"coolwarm\",\n","    center=0,\n","    mask=mask\n",")\n","\n","plt.title(\"Top 10 Features Correlated with SalePrice\")\n","plt.tight_layout()\n","\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":907},"id":"Mfy29RKPxdZt","executionInfo":{"status":"ok","timestamp":1795410373959,"user_tz":-330,"elapsed":477,"user":{"displayName":"Pushkar Thombare","userId":"03985106605329084109"}},"outputId":"1f46d47a-13e7-4ba1-8df8-82f1d222e91f"},"execution_count":46,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x900 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["#IQR Method\n","\n","The Interquartile Range (IQR) method is used\n","to identify potential outliers.\n","\n","The lower and upper boundaries are calculated\n","using Q1, Q3, and IQR.\n","\n","Observations outside these boundaries are\n","identified as potential outliers."],"metadata":{"id":"qkHU9DMtzSu4"}},{"cell_type":"code","source":["\n","def iqr_outliers(series):\n","\n","    # Calculate quartiles\n","    q1 = series.quantile(0.25)\n","    q3 = series.quantile(0.75)\n","\n","    # Calculate IQR\n","    iqr = q3 - q1\n","\n","    # Calculate boundaries\n","    lower_bound = q1 - 1.5 * iqr\n","    upper_bound = q3 + 1.5 * iqr\n","\n","    # Identify outliers\n","    outliers = series[\n","        (series < lower_bound) |\n","        (series > upper_bound)\n","    ]\n","\n","    return outliers\n","\n","\n","# Detect outliers in selected columns\n","for col in [\"GrLivArea\", \"SalePrice\"]:\n","\n","    result = iqr_outliers(df[col])\n","\n","    print(\"\\nColumn:\", col)\n","    print(\"Number of IQR Outliers:\", len(result))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0EET9gPlxdXF","executionInfo":{"status":"ok","timestamp":1795410457983,"user_tz":-330,"elapsed":45,"user":{"displayName":"Pushkar Thombare","userId":"03985106605329084109"}},"outputId":"5867ce6c-9d0b-421e-e240-0b9fa22c1b01"},"execution_count":47,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Column: GrLivArea\n","Number of IQR Outliers: 31\n","\n","Column: SalePrice\n","Number of IQR Outliers: 61\n"]}]},{"cell_type":"markdown","source":["##Z-score Method\n","\n","The Z-score method is used to identify\n","potential outliers based on their distance\n","from the mean.\n","\n","Observations with an absolute Z-score\n","greater than 3 are flagged as potential\n","outliers."],"metadata":{"id":"tqjbJjX0zhO0"}},{"cell_type":"code","source":["\n","#  Z-SCORE OUTLIER DETECTION\n","\n","def zscore_outliers(series, threshold=3):\n","\n","    # Calculate Z-scores\n","    z_scores = (series - series.mean()) / series.std()\n","\n","    # Ide